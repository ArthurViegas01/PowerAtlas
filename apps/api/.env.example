# PowerAtlas API (F3) environment.
# Copy to .env and adjust. All values have safe local defaults.

# Comma-separated browser origins allowed by CORS (web dev + preview).
PA_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173

# Uvicorn bind (dev).
PA_API_HOST=0.0.0.0
PA_API_PORT=8000

# development | production | test
PA_ENVIRONMENT=development

# F4 database (asyncpg DSN). Leave unset to read the bundled mock JSON: the
# payload is byte-identical either way, so offline dev needs no Postgres.
# PA_DATABASE_URL=postgresql://poweratlas:poweratlas_local_dev@localhost:5432/poweratlas

# Where scripts/migrate.py looks for the .sql files. Defaults to db/migrations
# relative to the repository root; the compose migrate service mounts them at
# /db/migrations and sets this.
# PA_MIGRATIONS_DIR=/db/migrations

# F5 worker (Celery). Defaults reach the dockerized redis from the host
# (`pnpm redis-up`); the compose worker service overrides the hostname.
# PA_REDIS_URL=redis://localhost:6379/0
# PA_CELERY_BROKER_URL=redis://localhost:6379/1
# PA_CELERY_RESULT_BACKEND=redis://localhost:6379/2

# F5b RSS ingestion. The user agent identifies the crawler honestly to the
# institutional feeds; the delay paces requests between sources.
# PA_INGEST_USER_AGENT=PowerAtlas/0.1 (prototipo de pesquisa; ingest piloto)
# PA_INGEST_TIMEOUT_S=30
# PA_INGEST_DELAY_S=1
