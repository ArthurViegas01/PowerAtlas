# PowerAtlas local stack (docker compose). Copy to `.env` at the repository
# root and adjust. Every value has a working default, so an empty `.env`
# (or no file at all) is a valid setup.

# Host port published by the `api` service. Override it when another project
# already owns 8000: the compose file also feeds it to the web container's
# VITE_API_URL, so the browser keeps reaching the right backend.
# PA_API_PORT=8010

# Per-service environment (database DSN, Redis, CORS, ingestion) lives in
# `apps/api/.env.example`; the compose services set those values themselves.
# Frontend variables (VITE_API_URL for host dev) live in
# `apps/web/.env.example`.
